# Copy to .env and fill in. Both keys are optional — the dashboard runs
# without them, showing a friendly notice on the pages that need them.
# Never commit your real .env.

# Anthropic Claude API key — enables AI analysis (Stock Analyzer, Macro,
# Portfolio). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# FRED API key — enables the Macro page indicators + yield curve. Free at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
