# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker-compose service) ---
POSTGRES_USER=stocks
POSTGRES_PASSWORD=stocks
POSTGRES_DB=stocks
# Host port the dockerized Postgres is published on (use 5433 if 5432 is taken)
POSTGRES_PORT=5432

# --- Backend ---
# URL for running the backend natively on the host (Postgres in Docker).
# Inside docker-compose the backend receives a container-specific URL
# automatically; this value is not used there.
DATABASE_URL=postgresql+psycopg://stocks:stocks@localhost:5432/stocks
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173
SCHEDULER_ENABLED=true

# --- Telegram alerts (used from Phase 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# --- Frontend (optional) ---
# Base URL the browser uses for API calls; default is /api/v1 via the dev proxy.
# VITE_API_BASE_URL=/api/v1
